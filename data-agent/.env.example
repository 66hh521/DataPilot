# Prefer environment variables over committing secrets to app_config.yaml.
DATA_AGENT_LLM_API_KEY=replace-me
DATA_AGENT_LLM_BASE_URL=https://api.deepseek.com
DATA_AGENT_LLM_MODEL=deepseek-v4-pro

# Use a MySQL account that only has SELECT permission on the dw database.
DATA_AGENT_DW_DB_USER=data_agent_ro
DATA_AGENT_DW_DB_PASSWORD=replace-me
